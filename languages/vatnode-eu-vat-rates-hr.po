msgid "Keeps WooCommerce EU tax rates up to date from the European Commission TEDB, and validates customer VAT numbers against VIES to apply the reverse charge."
msgstr "Održava stope PDV-a u EU u WooCommerceu ažurnima prema bazi TEDB Europske komisije i provjerava PDV identifikacijske brojeve kupaca u sustavu VIES radi primjene prijenosa porezne obveze."

msgid "EU VAT Rates"
msgstr "Stope PDV-a u EU"

msgid "Settings"
msgstr "Postavke"

msgid "Get an API key"
msgstr "Nabavi API ključ"

msgid "Insufficient permissions."
msgstr "Nedovoljna ovlaštenja."

msgid "EU VAT Rates and VIES Validation"
msgstr "Stope PDV-a u EU i provjera u VIES-u"

msgid "EU VAT rates synced successfully."
msgstr "Stope PDV-a u EU uspješno su sinkronizirane."

msgid "Sync failed."
msgstr "Sinkronizacija nije uspjela."

msgid "Settings saved."
msgstr "Postavke su spremljene."

msgid "API key accepted by vatnode."
msgstr "vatnode je prihvatio API ključ."

msgid "API key check failed."
msgstr "Provjera API ključa nije uspjela."

msgid "Sell to EU businesses without VAT"
msgstr "Prodajte tvrtkama u EU bez PDV-a"

msgid "Add a vatnode API key and the plugin checks customer VAT numbers against the official VIES service at checkout. Verified EU business buyers outside your country are charged no VAT, and the evidence is stored on the order."
msgstr "Dodajte vatnode API ključ i dodatak pri naplati provjerava PDV broj kupca u službenoj usluzi VIES. Provjerenim poslovnim kupcima iz drugih zemalja EU ne obračunava se PDV, a dokaz se sprema uz narudžbu."

msgid "Already have a vatnode account? %s and paste it below."
msgstr "Već imate vatnode račun? %s i zalijepite ga niže."

msgid "Create a key"
msgstr "Izradi ključ"

msgid "Get an API Key"
msgstr "Nabavi API ključ"

msgid "VAT number validation"
msgstr "Provjera PDV broja"

msgid "vatnode API key"
msgstr "vatnode API ključ"

msgid "A key is stored. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Ključ je spremljen. Ostavite polje prazno da ga zadržite ili zalijepite novi da ga zamijenite."

msgid "Create a key in your %s dashboard. The free plan includes a monthly request quota."
msgstr "Izradite ključ na nadzornoj ploči %s. Besplatni plan uključuje mjesečnu kvotu zahtjeva."

msgid "Key status:"
msgstr "Status ključa:"

msgid "Working"
msgstr "Radi"

msgid "Rejected by vatnode"
msgstr "Odbijen od vatnodea"

msgid "Monthly quota exceeded"
msgstr "Mjesečna kvota je premašena"

msgid "Could not reach vatnode"
msgstr "vatnode nije dostupan"

msgid "Last call failed"
msgstr "Posljednji poziv nije uspio"

msgid "Not checked yet"
msgstr "Još nije provjeren"

msgid "Checkout"
msgstr "Naplata"

msgid "Verify VAT numbers with VIES and apply the reverse charge"
msgstr "Provjeravaj PDV brojeve u VIES-u i primijeni prijenos porezne obveze"

msgid "The VAT number field is always shown at checkout. Without a key the number is only format-checked and stored — VAT is still charged."
msgstr "Polje za PDV broj uvijek je prikazano pri naplati. Bez ključa broj se samo provjerava po formatu i sprema — PDV se i dalje obračunava."

msgid "Make the VAT number field required"
msgstr "Postavi polje za PDV broj kao obavezno"

msgid "Only for B2B-only stores — consumers do not have a VAT number."
msgstr "Samo za trgovine isključivo za poslovne kupce — potrošači nemaju PDV broj."

msgid "Which rate applies"
msgstr "Koja stopa vrijedi"

msgid "This store is registered for the EU One Stop Shop (OSS)"
msgstr "Ova trgovina registrirana je u sustavu jedinstvene točke EU (OSS)"

msgid "Registered: consumers in other EU countries are charged the rate of their own country. Not registered: every EU buyer is charged the %s rate, which is what applies while your cross-border sales stay under the EU-wide 10,000 EUR threshold."
msgstr "Registrirana: potrošačima iz drugih zemalja EU obračunava se stopa njihove vlastite zemlje. Nije registrirana: svim kupcima iz EU obračunava se stopa %s, što vrijedi dok vaša prekogranična prodaja ostaje ispod praga od 10.000 EUR na razini EU."

msgid "Save Settings"
msgstr "Spremi postavke"

msgid "Remove key"
msgstr "Ukloni ključ"

msgid "Test Key"
msgstr "Testiraj ključ"

msgid "Reverse charge is active for verified EU business buyers outside your country."
msgstr "Prijenos porezne obveze aktivan je za provjerene tvrtke iz EU izvan vaše zemlje."

msgid "Rate sync"
msgstr "Sinkronizacija stopa"

msgid "Auto-sync"
msgstr "Automatska sinkronizacija"

msgid "Active — daily"
msgstr "Aktivna — dnevno"

msgid "Last sync"
msgstr "Posljednja sinkronizacija"

msgid "Never"
msgstr "Nikad"

msgid "Data version"
msgstr "Verzija podataka"

msgid "Next auto-sync"
msgstr "Sljedeća automatska sinkronizacija"

msgid "Source"
msgstr "Izvor"

msgid "(European Commission TEDB)"
msgstr "(TEDB Europske komisije)"

msgid "Sync Now"
msgstr "Sinkroniziraj sada"

msgid "Current rates (%d countries)"
msgstr "Trenutne stope (%d zemalja)"

msgid "Country"
msgstr "Zemlja"

msgid "Code"
msgstr "Kod"

msgid "Standard"
msgstr "Standardna"

msgid "Reduced"
msgstr "Snižena"

msgid "Super-reduced"
msgstr "Posebno snižena"

msgid "Parking"
msgstr "Prijelazna"

msgid "No vatnode API key configured."
msgstr "vatnode API ključ nije postavljen."

msgid "vatnode API returned HTTP %d."
msgstr "vatnode API vratio je HTTP %d."

msgid "Enter an API key first."
msgstr "Najprije unesite API ključ."

msgid "API key was rejected by vatnode."
msgstr "vatnode je odbio API ključ."

msgid "VAT number"
msgstr "PDV broj"

msgid "Please enter your VAT number."
msgstr "Unesite svoj PDV broj."

msgid "e.g. DE123456789"
msgstr "npr. DE123456789"

msgid "EU businesses outside our country: enter your VAT number to buy without VAT."
msgstr "Tvrtke iz EU izvan naše zemlje: unesite svoj PDV broj za kupnju bez PDV-a."

msgid "VAT number %1$s — %2$s"
msgstr "PDV broj %1$s — %2$s"

msgid "EU VAT"
msgstr "PDV u EU"

msgid "VAT number:"
msgstr "PDV broj:"

msgid "Status:"
msgstr "Status:"

msgid "Reverse charge:"
msgstr "Prijenos porezne obveze:"

msgid "Applied"
msgstr "Primijenjen"

msgid "Not applied"
msgstr "Nije primijenjen"

msgid "Registered name:"
msgstr "Registrirani naziv:"

msgid "VIES consultation number:"
msgstr "Broj potvrde VIES:"

msgid "Checked:"
msgstr "Provjereno:"

msgid "Not scheduled"
msgstr "Nije zakazano"

msgid "VAT number could not be verified — VAT charged as usual."
msgstr "PDV broj nije bilo moguće provjeriti — PDV je obračunat kao i obično."

msgid "Reverse charge applies only to stores based in the EU."
msgstr "Prijenos porezne obveze primjenjuje se samo na trgovine sa sjedištem u EU."

msgid "This does not look like a valid EU VAT number. Check it, or leave the field empty."
msgstr "Ovo ne izgleda kao valjan PDV broj u EU. Provjerite ga ili ostavite polje prazno."

msgid "The VAT number is registered in %1$s but the billing address is in %2$s. They must match."
msgstr "PDV broj registriran je u %1$s, a adresa za naplatu je u %2$s. Moraju se podudarati."

msgid "Domestic sale — VAT is charged as usual."
msgstr "Domaća prodaja — PDV se obračunava kao i obično."

msgid "This VAT number is not registered in VIES. Check it, or leave the field empty to pay VAT."
msgstr "Ovaj PDV broj nije registriran u VIES-u. Provjerite ga ili ostavite polje prazno da platite PDV."

msgid "VAT number verified — reverse charge applies."
msgstr "PDV broj je provjeren — primjenjuje se prijenos porezne obveze."

msgid "Verified — reverse charge applied"
msgstr "Provjeren — prijenos porezne obveze primijenjen"

msgid "Not registered in VIES"
msgstr "Nije registriran u VIES-u"

msgid "Invalid format"
msgstr "Neispravan format"

msgid "VAT country does not match billing country"
msgstr "Zemlja PDV broja ne odgovara zemlji naplate"

msgid "Domestic sale — VAT charged"
msgstr "Domaća prodaja — PDV obračunat"

msgid "Outside the EU VAT area"
msgstr "Izvan područja PDV-a u EU"

msgid "Not verified — VAT charged"
msgstr "Nije provjeren — PDV obračunat"

msgid "No VAT number provided"
msgstr "PDV broj nije naveden"

msgid "requires WooCommerce to be active."
msgstr "zahtijeva aktivan WooCommerce."
