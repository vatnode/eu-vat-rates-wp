msgid "Keeps WooCommerce EU tax rates up to date from the European Commission TEDB, and validates customer VAT numbers against VIES to apply the reverse charge."
msgstr "Διατηρεί ενημερωμένους τους συντελεστές ΦΠΑ της ΕΕ στο WooCommerce από τη βάση TEDB της Ευρωπαϊκής Επιτροπής και επαληθεύει τους ΑΦΜ/ΦΠΑ των πελατών μέσω VIES για την εφαρμογή της αντιστροφής της επιβάρυνσης."

msgid "EU VAT Rates"
msgstr "Συντελεστές ΦΠΑ ΕΕ"

msgid "Settings"
msgstr "Ρυθμίσεις"

msgid "Get an API key"
msgstr "Αποκτήστε κλειδί API"

msgid "Insufficient permissions."
msgstr "Ανεπαρκή δικαιώματα."

msgid "EU VAT Rates and VIES Validation"
msgstr "Συντελεστές ΦΠΑ ΕΕ και επαλήθευση VIES"

msgid "EU VAT rates synced successfully."
msgstr "Οι συντελεστές ΦΠΑ της ΕΕ συγχρονίστηκαν με επιτυχία."

msgid "Sync failed."
msgstr "Ο συγχρονισμός απέτυχε."

msgid "Settings saved."
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν."

msgid "API key accepted by vatnode."
msgstr "Το κλειδί API έγινε δεκτό από το vatnode."

msgid "API key check failed."
msgstr "Ο έλεγχος του κλειδιού API απέτυχε."

msgid "Sell to EU businesses without VAT"
msgstr "Πουλήστε σε επιχειρήσεις της ΕΕ χωρίς ΦΠΑ"

msgid "Add a vatnode API key and the plugin checks customer VAT numbers against the official VIES service at checkout. Verified EU business buyers outside your country are charged no VAT, and the evidence is stored on the order."
msgstr "Προσθέστε ένα κλειδί API του vatnode και το πρόσθετο ελέγχει τον αριθμό ΦΠΑ του πελάτη στην επίσημη υπηρεσία VIES κατά την ολοκλήρωση της παραγγελίας. Οι επαληθευμένες επιχειρήσεις της ΕΕ εκτός της χώρας σας δεν χρεώνονται ΦΠΑ και το αποδεικτικό αποθηκεύεται στην παραγγελία."

msgid "Already have a vatnode account? %s and paste it below."
msgstr "Έχετε ήδη λογαριασμό vatnode; %s και επικολλήστε το παρακάτω."

msgid "Create a key"
msgstr "Δημιουργία κλειδιού"

msgid "Get an API Key"
msgstr "Αποκτήστε κλειδί API"

msgid "VAT number validation"
msgstr "Επαλήθευση αριθμού ΦΠΑ"

msgid "vatnode API key"
msgstr "Κλειδί API vatnode"

msgid "A key is stored. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Υπάρχει αποθηκευμένο κλειδί. Αφήστε το πεδίο κενό για να το διατηρήσετε ή επικολλήστε ένα νέο για να το αντικαταστήσετε."

msgid "Create a key in your %s dashboard. The free plan includes a monthly request quota."
msgstr "Δημιουργήστε ένα κλειδί στον πίνακα %s. Το δωρεάν πρόγραμμα περιλαμβάνει μηνιαίο όριο αιτημάτων."

msgid "Key status:"
msgstr "Κατάσταση κλειδιού:"

msgid "Working"
msgstr "Λειτουργεί"

msgid "Rejected by vatnode"
msgstr "Απορρίφθηκε από το vatnode"

msgid "Monthly quota exceeded"
msgstr "Το μηνιαίο όριο εξαντλήθηκε"

msgid "Could not reach vatnode"
msgstr "Αδυναμία σύνδεσης με το vatnode"

msgid "Last call failed"
msgstr "Η τελευταία κλήση απέτυχε"

msgid "Not checked yet"
msgstr "Δεν έχει ελεγχθεί ακόμη"

msgid "Checkout"
msgstr "Ολοκλήρωση παραγγελίας"

msgid "Verify VAT numbers with VIES and apply the reverse charge"
msgstr "Επαλήθευση αριθμών ΦΠΑ μέσω VIES και εφαρμογή της αντιστροφής της επιβάρυνσης"

msgid "The VAT number field is always shown at checkout. Without a key the number is only format-checked and stored — VAT is still charged."
msgstr "Το πεδίο του αριθμού ΦΠΑ εμφανίζεται πάντα κατά την ολοκλήρωση της παραγγελίας. Χωρίς κλειδί, ο αριθμός ελέγχεται μόνο ως προς τη μορφή του και αποθηκεύεται — ο ΦΠΑ εξακολουθεί να χρεώνεται."

msgid "Make the VAT number field required"
msgstr "Να είναι υποχρεωτικό το πεδίο του αριθμού ΦΠΑ"

msgid "Only for B2B-only stores — consumers do not have a VAT number."
msgstr "Μόνο για καταστήματα αποκλειστικά B2B — οι ιδιώτες δεν έχουν αριθμό ΦΠΑ."

msgid "Which rate applies"
msgstr "Ποιος συντελεστής ισχύει"

msgid "This store is registered for the EU One Stop Shop (OSS)"
msgstr "Αυτό το κατάστημα είναι εγγεγραμμένο στη μονοαπευθυντική θυρίδα της ΕΕ (OSS)"

msgid "Registered: consumers in other EU countries are charged the rate of their own country. Not registered: every EU buyer is charged the %s rate, which is what applies while your cross-border sales stay under the EU-wide 10,000 EUR threshold."
msgstr "Εγγεγραμμένο: στους καταναλωτές άλλων χωρών της ΕΕ χρεώνεται ο συντελεστής της δικής τους χώρας. Μη εγγεγραμμένο: σε κάθε αγοραστή της ΕΕ χρεώνεται ο συντελεστής %s, που ισχύει όσο οι διασυνοριακές πωλήσεις σας παραμένουν κάτω από το όριο των 10.000 EUR για ολόκληρη την ΕΕ."

msgid "Save Settings"
msgstr "Αποθήκευση ρυθμίσεων"

msgid "Remove key"
msgstr "Αφαίρεση κλειδιού"

msgid "Test Key"
msgstr "Δοκιμή κλειδιού"

msgid "Reverse charge is active for verified EU business buyers outside your country."
msgstr "Η αντιστροφή της επιβάρυνσης είναι ενεργή για επαληθευμένες επιχειρήσεις της ΕΕ εκτός της χώρας σας."

msgid "Rate sync"
msgstr "Συγχρονισμός συντελεστών"

msgid "Auto-sync"
msgstr "Αυτόματος συγχρονισμός"

msgid "Active — daily"
msgstr "Ενεργός — καθημερινά"

msgid "Last sync"
msgstr "Τελευταίος συγχρονισμός"

msgid "Never"
msgstr "Ποτέ"

msgid "Data version"
msgstr "Έκδοση δεδομένων"

msgid "Next auto-sync"
msgstr "Επόμενος αυτόματος συγχρονισμός"

msgid "Source"
msgstr "Πηγή"

msgid "(European Commission TEDB)"
msgstr "(TEDB της Ευρωπαϊκής Επιτροπής)"

msgid "Sync Now"
msgstr "Συγχρονισμός τώρα"

msgid "Current rates (%d countries)"
msgstr "Τρέχοντες συντελεστές (%d χώρες)"

msgid "Country"
msgstr "Χώρα"

msgid "Code"
msgstr "Κωδικός"

msgid "Standard"
msgstr "Κανονικός"

msgid "Reduced"
msgstr "Μειωμένος"

msgid "Super-reduced"
msgstr "Υπερμειωμένος"

msgid "Parking"
msgstr "Ενδιάμεσος"

msgid "No vatnode API key configured."
msgstr "Δεν έχει ρυθμιστεί κλειδί API του vatnode."

msgid "vatnode API returned HTTP %d."
msgstr "Το API του vatnode επέστρεψε HTTP %d."

msgid "Enter an API key first."
msgstr "Εισαγάγετε πρώτα ένα κλειδί API."

msgid "API key was rejected by vatnode."
msgstr "Το κλειδί API απορρίφθηκε από το vatnode."

msgid "VAT number"
msgstr "Αριθμός ΦΠΑ"

msgid "Please enter your VAT number."
msgstr "Εισαγάγετε τον αριθμό ΦΠΑ σας."

msgid "e.g. DE123456789"
msgstr "π.χ. DE123456789"

msgid "EU businesses outside our country: enter your VAT number to buy without VAT."
msgstr "Επιχειρήσεις της ΕΕ εκτός της χώρας μας: εισαγάγετε τον αριθμό ΦΠΑ σας για αγορά χωρίς ΦΠΑ."

msgid "VAT number %1$s — %2$s"
msgstr "Αριθμός ΦΠΑ %1$s — %2$s"

msgid "EU VAT"
msgstr "ΦΠΑ ΕΕ"

msgid "VAT number:"
msgstr "Αριθμός ΦΠΑ:"

msgid "Status:"
msgstr "Κατάσταση:"

msgid "Reverse charge:"
msgstr "Αντιστροφή της επιβάρυνσης:"

msgid "Applied"
msgstr "Εφαρμόστηκε"

msgid "Not applied"
msgstr "Δεν εφαρμόστηκε"

msgid "Registered name:"
msgstr "Καταχωρισμένη επωνυμία:"

msgid "VIES consultation number:"
msgstr "Αριθμός διαβούλευσης VIES:"

msgid "Checked:"
msgstr "Ελέγχθηκε:"

msgid "Not scheduled"
msgstr "Δεν έχει προγραμματιστεί"

msgid "VAT number could not be verified — VAT charged as usual."
msgstr "Ο αριθμός ΦΠΑ δεν ήταν δυνατό να επαληθευτεί — ο ΦΠΑ χρεώθηκε κανονικά."

msgid "Reverse charge applies only to stores based in the EU."
msgstr "Η αντιστροφή της επιβάρυνσης ισχύει μόνο για καταστήματα εγκατεστημένα στην ΕΕ."

msgid "This does not look like a valid EU VAT number. Check it, or leave the field empty."
msgstr "Αυτό δεν μοιάζει με έγκυρο αριθμό ΦΠΑ της ΕΕ. Ελέγξτε τον ή αφήστε το πεδίο κενό."

msgid "The VAT number is registered in %1$s but the billing address is in %2$s. They must match."
msgstr "Ο αριθμός ΦΠΑ είναι καταχωρισμένος σε %1$s αλλά η διεύθυνση χρέωσης βρίσκεται σε %2$s. Πρέπει να συμφωνούν."

msgid "Domestic sale — VAT is charged as usual."
msgstr "Εγχώρια πώληση — ο ΦΠΑ χρεώνεται κανονικά."

msgid "This VAT number is not registered in VIES. Check it, or leave the field empty to pay VAT."
msgstr "Αυτός ο αριθμός ΦΠΑ δεν είναι καταχωρισμένος στο VIES. Ελέγξτε τον ή αφήστε το πεδίο κενό για να πληρώσετε ΦΠΑ."

msgid "VAT number verified — reverse charge applies."
msgstr "Ο αριθμός ΦΠΑ επαληθεύτηκε — ισχύει η αντιστροφή της επιβάρυνσης."

msgid "Verified — reverse charge applied"
msgstr "Επαληθεύτηκε — εφαρμόστηκε αντιστροφή της επιβάρυνσης"

msgid "Not registered in VIES"
msgstr "Δεν είναι καταχωρισμένος στο VIES"

msgid "Invalid format"
msgstr "Μη έγκυρη μορφή"

msgid "VAT country does not match billing country"
msgstr "Η χώρα του αριθμού ΦΠΑ δεν συμφωνεί με τη χώρα χρέωσης"

msgid "Domestic sale — VAT charged"
msgstr "Εγχώρια πώληση — ΦΠΑ χρεώθηκε"

msgid "Outside the EU VAT area"
msgstr "Εκτός του εδάφους ΦΠΑ της ΕΕ"

msgid "Not verified — VAT charged"
msgstr "Δεν επαληθεύτηκε — ΦΠΑ χρεώθηκε"

msgid "No VAT number provided"
msgstr "Δεν δόθηκε αριθμός ΦΠΑ"

msgid "requires WooCommerce to be active."
msgstr "απαιτεί ενεργό WooCommerce."
