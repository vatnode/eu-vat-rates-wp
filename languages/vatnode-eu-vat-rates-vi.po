msgid "Keeps WooCommerce EU tax rates up to date from the European Commission TEDB, and validates customer VAT numbers against VIES to apply the reverse charge."
msgstr "Giữ cho thuế suất GTGT của EU trong WooCommerce luôn cập nhật từ cơ sở dữ liệu TEDB của Ủy ban châu Âu và kiểm tra mã số thuế GTGT của khách hàng qua VIES để áp dụng cơ chế đảo ngược nghĩa vụ thuế."

msgid "EU VAT Rates"
msgstr "Thuế suất GTGT của EU"

msgid "Settings"
msgstr "Cài đặt"

msgid "Get an API key"
msgstr "Lấy khóa API"

msgid "Insufficient permissions."
msgstr "Không đủ quyền."

msgid "EU VAT Rates and VIES Validation"
msgstr "Thuế suất GTGT của EU và kiểm tra VIES"

msgid "EU VAT rates synced successfully."
msgstr "Đã đồng bộ thuế suất GTGT của EU."

msgid "Sync failed."
msgstr "Đồng bộ không thành công."

msgid "Settings saved."
msgstr "Đã lưu cài đặt."

msgid "API key accepted by vatnode."
msgstr "vatnode đã chấp nhận khóa API."

msgid "API key check failed."
msgstr "Kiểm tra khóa API không thành công."

msgid "Sell to EU businesses without VAT"
msgstr "Bán cho doanh nghiệp EU không kèm thuế GTGT"

msgid "Add a vatnode API key and the plugin checks customer VAT numbers against the official VIES service at checkout. Verified EU business buyers outside your country are charged no VAT, and the evidence is stored on the order."
msgstr "Thêm khóa API của vatnode và plugin sẽ kiểm tra mã số thuế GTGT của khách hàng trên dịch vụ chính thức VIES khi thanh toán. Doanh nghiệp EU đã xác minh ở ngoài quốc gia của bạn không bị tính thuế GTGT, và bằng chứng được lưu cùng đơn hàng."

msgid "Already have a vatnode account? %s and paste it below."
msgstr "Bạn đã có tài khoản vatnode? %s và dán vào bên dưới."

msgid "Create a key"
msgstr "Tạo khóa"

msgid "Get an API Key"
msgstr "Lấy khóa API"

msgid "VAT number validation"
msgstr "Kiểm tra mã số thuế GTGT"

msgid "vatnode API key"
msgstr "Khóa API của vatnode"

msgid "A key is stored. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Đã lưu một khóa. Để trống ô này để giữ nguyên, hoặc dán khóa mới để thay thế."

msgid "Create a key in your %s dashboard. The free plan includes a monthly request quota."
msgstr "Tạo khóa trong bảng điều khiển %s. Gói miễn phí bao gồm hạn mức yêu cầu hằng tháng."

msgid "Key status:"
msgstr "Trạng thái khóa:"

msgid "Working"
msgstr "Hoạt động"

msgid "Rejected by vatnode"
msgstr "Bị vatnode từ chối"

msgid "Monthly quota exceeded"
msgstr "Đã vượt hạn mức hằng tháng"

msgid "Could not reach vatnode"
msgstr "Không kết nối được vatnode"

msgid "Last call failed"
msgstr "Lệnh gọi gần nhất không thành công"

msgid "Not checked yet"
msgstr "Chưa kiểm tra"

msgid "Checkout"
msgstr "Thanh toán"

msgid "Verify VAT numbers with VIES and apply the reverse charge"
msgstr "Kiểm tra mã số thuế GTGT qua VIES và áp dụng cơ chế đảo ngược nghĩa vụ thuế"

msgid "The VAT number field is always shown at checkout. Without a key the number is only format-checked and stored — VAT is still charged."
msgstr "Ô mã số thuế GTGT luôn hiển thị khi thanh toán. Nếu không có khóa, mã số chỉ được kiểm tra về định dạng và lưu lại — thuế GTGT vẫn được tính."

msgid "Make the VAT number field required"
msgstr "Bắt buộc nhập mã số thuế GTGT"

msgid "Only for B2B-only stores — consumers do not have a VAT number."
msgstr "Chỉ dành cho cửa hàng thuần B2B — người tiêu dùng không có mã số thuế GTGT."

msgid "Which rate applies"
msgstr "Thuế suất nào được áp dụng"

msgid "This store is registered for the EU One Stop Shop (OSS)"
msgstr "Cửa hàng này đã đăng ký cơ chế một cửa của EU (OSS)"

msgid "Registered: consumers in other EU countries are charged the rate of their own country. Not registered: every EU buyer is charged the %s rate, which is what applies while your cross-border sales stay under the EU-wide 10,000 EUR threshold."
msgstr "Đã đăng ký: người tiêu dùng ở các nước EU khác chịu thuế suất của chính nước họ. Chưa đăng ký: mọi người mua trong EU chịu thuế suất %s, điều này áp dụng chừng nào doanh số xuyên biên giới của bạn còn dưới ngưỡng 10.000 EUR toàn EU."

msgid "Save Settings"
msgstr "Lưu cài đặt"

msgid "Remove key"
msgstr "Xóa khóa"

msgid "Test Key"
msgstr "Thử khóa"

msgid "Reverse charge is active for verified EU business buyers outside your country."
msgstr "Cơ chế đảo ngược nghĩa vụ thuế đang hoạt động cho doanh nghiệp EU đã xác minh ở ngoài quốc gia của bạn."

msgid "Rate sync"
msgstr "Đồng bộ thuế suất"

msgid "Auto-sync"
msgstr "Tự động đồng bộ"

msgid "Active — daily"
msgstr "Đang bật — hằng ngày"

msgid "Last sync"
msgstr "Lần đồng bộ gần nhất"

msgid "Never"
msgstr "Chưa bao giờ"

msgid "Data version"
msgstr "Phiên bản dữ liệu"

msgid "Next auto-sync"
msgstr "Lần tự động đồng bộ tiếp theo"

msgid "Source"
msgstr "Nguồn"

msgid "(European Commission TEDB)"
msgstr "(TEDB của Ủy ban châu Âu)"

msgid "Sync Now"
msgstr "Đồng bộ ngay"

msgid "Current rates (%d countries)"
msgstr "Thuế suất hiện tại (%d quốc gia)"

msgid "Country"
msgstr "Quốc gia"

msgid "Code"
msgstr "Mã"

msgid "Standard"
msgstr "Tiêu chuẩn"

msgid "Reduced"
msgstr "Ưu đãi"

msgid "Super-reduced"
msgstr "Ưu đãi đặc biệt"

msgid "Parking"
msgstr "Chuyển tiếp"

msgid "No vatnode API key configured."
msgstr "Chưa cấu hình khóa API của vatnode."

msgid "vatnode API returned HTTP %d."
msgstr "API của vatnode trả về HTTP %d."

msgid "Enter an API key first."
msgstr "Hãy nhập khóa API trước."

msgid "API key was rejected by vatnode."
msgstr "Khóa API đã bị vatnode từ chối."

msgid "VAT number"
msgstr "Mã số thuế GTGT"

msgid "Please enter your VAT number."
msgstr "Vui lòng nhập mã số thuế GTGT của bạn."

msgid "e.g. DE123456789"
msgstr "ví dụ DE123456789"

msgid "EU businesses outside our country: enter your VAT number to buy without VAT."
msgstr "Doanh nghiệp EU ngoài quốc gia của chúng tôi: nhập mã số thuế GTGT để mua hàng không kèm thuế."

msgid "VAT number %1$s — %2$s"
msgstr "Mã số thuế GTGT %1$s — %2$s"

msgid "EU VAT"
msgstr "GTGT của EU"

msgid "VAT number:"
msgstr "Mã số thuế GTGT:"

msgid "Status:"
msgstr "Trạng thái:"

msgid "Reverse charge:"
msgstr "Đảo ngược nghĩa vụ thuế:"

msgid "Applied"
msgstr "Đã áp dụng"

msgid "Not applied"
msgstr "Chưa áp dụng"

msgid "Registered name:"
msgstr "Tên đã đăng ký:"

msgid "VIES consultation number:"
msgstr "Số tra cứu VIES:"

msgid "Checked:"
msgstr "Đã kiểm tra:"

msgid "Not scheduled"
msgstr "Chưa lên lịch"

msgid "VAT number could not be verified — VAT charged as usual."
msgstr "Không thể xác minh mã số thuế GTGT — thuế GTGT vẫn được tính như thường lệ."

msgid "Reverse charge applies only to stores based in the EU."
msgstr "Cơ chế đảo ngược nghĩa vụ thuế chỉ áp dụng cho cửa hàng đặt tại EU."

msgid "This does not look like a valid EU VAT number. Check it, or leave the field empty."
msgstr "Đây có vẻ không phải mã số thuế GTGT hợp lệ của EU. Hãy kiểm tra lại, hoặc để trống ô này."

msgid "The VAT number is registered in %1$s but the billing address is in %2$s. They must match."
msgstr "Mã số thuế GTGT được đăng ký tại %1$s nhưng địa chỉ thanh toán lại ở %2$s. Hai bên phải khớp nhau."

msgid "Domestic sale — VAT is charged as usual."
msgstr "Bán hàng trong nước — thuế GTGT được tính như thường lệ."

msgid "This VAT number is not registered in VIES. Check it, or leave the field empty to pay VAT."
msgstr "Mã số thuế GTGT này không có trong VIES. Hãy kiểm tra lại, hoặc để trống ô này để trả thuế GTGT."

msgid "VAT number verified — reverse charge applies."
msgstr "Đã xác minh mã số thuế GTGT — áp dụng cơ chế đảo ngược nghĩa vụ thuế."

msgid "Verified — reverse charge applied"
msgstr "Đã xác minh — đã áp dụng đảo ngược nghĩa vụ thuế"

msgid "Not registered in VIES"
msgstr "Không có trong VIES"

msgid "Invalid format"
msgstr "Định dạng không hợp lệ"

msgid "VAT country does not match billing country"
msgstr "Quốc gia của mã số thuế GTGT không khớp với quốc gia thanh toán"

msgid "Domestic sale — VAT charged"
msgstr "Bán hàng trong nước — đã tính thuế GTGT"

msgid "Outside the EU VAT area"
msgstr "Ngoài lãnh thổ GTGT của EU"

msgid "Not verified — VAT charged"
msgstr "Chưa xác minh — đã tính thuế GTGT"

msgid "No VAT number provided"
msgstr "Chưa cung cấp mã số thuế GTGT"

msgid "requires WooCommerce to be active."
msgstr "yêu cầu WooCommerce đang hoạt động."
